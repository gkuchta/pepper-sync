[Unit]
Description=Copy Pepper's Ghost videos from remote storage
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/data/tinygarretts
ConditionPathExists=/etc/pepper-sync/rclone.conf

[Service]
Type=oneshot
User=pepper-sync
Group=pepper-sync
UMask=0022
ExecStart=/usr/bin/rclone copy tinycrypt: /data/tinygarretts/ --size-only --config /etc/pepper-sync/rclone.conf --ask-password=false --log-level INFO
TimeoutStartSec=infinity
CacheDirectory=pepper-sync
CacheDirectoryMode=0700
Environment=RCLONE_CACHE_DIR=/var/cache/pepper-sync
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/data/tinygarretts /etc/pepper-sync
