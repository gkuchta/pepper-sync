#!/bin/sh
set -e

case "$1" in
    configure)
        adduser --system --group --home /nonexistent --no-create-home \
            --shell /usr/sbin/nologin pepper-sync

        # Do not recursively change existing videos or the shared /data parent.
        install -d -o pepper-sync -g pepper-sync -m 0755 /data/video

        # rclone may atomically replace this file when refreshing OAuth tokens.
        install -d -o pepper-sync -g pepper-sync -m 0700 /etc/pepper-sync
        ;;
esac

#DEBHELPER#
